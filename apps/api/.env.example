# Copy to apps/api/.env for local development. Never commit the real .env.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# MongoDB Atlas (BLOCKED until provisioned). Local: mongodb://127.0.0.1:27017/vyro?replicaSet=rs0
MONGODB_URI=
# Redis (rate limiting, queues). Leave empty to use in-process fallbacks in development only.
REDIS_URL=redis://127.0.0.1:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 32 bytes hex. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Google Sign-In OAuth client IDs (web, iOS, Android), comma-separated. BLOCKED until created.
GOOGLE_CLIENT_IDS=

# SMTP connection URL (e.g. AWS SES SMTP). Empty in development logs emails to the console.
SMTP_URL=
MAIL_FROM="VYRO <no-reply@localhost>"

SENTRY_DSN=
LOG_LEVEL=info
BRAND_NAME=
