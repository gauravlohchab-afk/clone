{
  "name": "@vyro/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test": "vitest run"
  },
  "dependencies": {
    "@vyro/config": "workspace:*",
    "@vyro/shared": "workspace:*",
    "@vyro/types": "workspace:*",
    "@vyro/validation": "workspace:*",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "google-auth-library": "^10.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "mongoose": "^8.19.0",
    "nodemailer": "^7.0.9",
    "otplib": "^12.0.1",
    "pino": "^9.13.0",
    "pino-http": "^10.5.0",
    "rate-limit-redis": "^4.2.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^6.4.20",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.2.3",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
